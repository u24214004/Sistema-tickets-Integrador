<configuration>
  <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{HH:mm:ss} %-5level %logger{32} - %msg%n</pattern></encoder>
  </appender>
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/tickets.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/tickets.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>5MB</maxFileSize><maxHistory>7</maxHistory><totalSizeCap>50MB</totalSizeCap>
    </rollingPolicy>
    <encoder><pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{40} - %msg%n</pattern></encoder>
  </appender>
  <logger name="org.hibernate.orm.jdbc.bind" level="OFF"/>
  <logger name="org.hibernate.SQL" level="WARN"/>
  <root level="INFO"><appender-ref ref="CONSOLE"/><appender-ref ref="FILE"/></root>
</configuration>
